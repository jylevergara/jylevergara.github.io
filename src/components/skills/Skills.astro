---
import Title from '../atoms/Title.astro';
import './skills.css';
import SkillsOnTerminal from './skillsOnTerminal.astro';
const skills = [
	{ id: 'javascript', label: 'JavaScript' },
	{ id: 'react', label: 'React' },
	{ id: 'nodejs', label: 'Node.js' },
	{ id: 'postgresql', label: 'PostgreSQL' },
	{ id: 'typescript', label: 'TypeScript' },
	{ id: 'nextjs', label: 'Next.js' },
	{ id: 'python', label: 'Python' },
	{ id: 'cpp', label: 'C++' },
	{ id: 'html', label: 'HTML' },
	{ id: 'css', label: 'CSS' },
	{ id: 'styledcomponents', label: 'Styled Components' },
	{ id: 'tailwindcss', label: 'Tailwind CSS' },
	{ id: 'materialui', label: 'Material UI' },
	{ id: 'bootstrap', label: 'Bootstrap' },
	{ id: 'aws', label: 'AWS' },
	{ id: 'redux', label: 'Redux' },
	{ id: 'webpack', label: 'Webpack' },
	{ id: 'figma', label: 'Figma' },
	{ id: 'github', label: 'GitHub' },
	{ id: 'sentry', label: 'Sentry' },
	{ id: 'postman', label: 'Postman' },
	{ id: 'docker', label: 'Docker' },
	{ id: 'apple', label: 'Apple' },
	{ id: 'wordpress', label: 'WordPress' },
	{ id: 'vite', label: 'Vite' },
	{ id: 'astro', label: 'Astro' },
	{ id: 'vercel', label: 'Vercel' },
	{ id: 'atom', label: 'Atom' },
	{ id: 'babel', label: 'Babel' },
	{ id: 'firebase', label: 'Firebase' },
];
---

<section id="skills">
	<!-- <SkillsOnTerminal /> -->
	<div class="skills__container">
		<div class="skills__icons">
			{
				skills.map((skill) => (
					<div class="skill-icon" data-label={skill.label}>
						<img
							src={`https://skillicons.dev/icons?i=${skill.id}&theme=dark`}
							alt={skill.label}
							width="48"
							height="48"
						/>
					</div>
				))
			}
		</div>
		<div class="text-content">
			<Title text="Skills" />
			<p class="skills__text">
				I specialize in full-stack development with expertise in
				JavaScript, TypeScript, React, Node.js, and Next.js. My
				technical foundation extends to SQL, PostgreSQL, and Python. I
				build scalable applications using AWS, GitHub, and JIRA, while
				leveraging BigQuery and Google Analytics to make data-driven
				decisions that enhance user experience.
			</p>
		</div>
	</div>
</section>
